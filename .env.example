# =============================================================================
# .env.example  -  TEMPLATE FOR YOUR SETTINGS
# =============================================================================
# Copy this file to a new file called  .env  and change the values:
#       cp .env.example .env
# The app (and docker compose) read .env automatically.
# NEVER commit your real .env to git: it contains secrets.
# All settings are explained in app/config.py.
# =============================================================================

# "development" or "production". Production refuses to start with a weak SECRET_KEY.
ENVIRONMENT=development

# Signs login tokens. Make a good one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=insecure-dev-secret-do-not-use-in-production

# Local development: a simple SQLite file (nothing to install).
DATABASE_URL=sqlite+aiosqlite:///./uptime.db
# Production: PostgreSQL.
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/uptime

# Used by docker compose only (the password of the Postgres container).
# POSTGRES_PASSWORD=choose-a-password

# --- Optional tuning (these are the defaults) ---
# WORKER_COUNT=5                  how many websites are checked at the same time
# SCHEDULER_INTERVAL_SECONDS=5    how often we look for monitors that are due
# REQUEST_TIMEOUT_SECONDS=10      how long we wait for a website to answer
# CHECK_RETENTION_DAYS=30         how long check history is kept
# MAX_MONITORS_PER_USER=50

# Only for local experiments with a website on your own computer (blocked by default for safety).
# ALLOW_PRIVATE_URLS=true
